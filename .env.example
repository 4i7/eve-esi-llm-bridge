# Required: public EVE Developer Application client ID.
# Create your own app at https://developers.eveonline.com/
EVE_CLIENT_ID=

# Required: generate with `npm run secret` (32 random bytes, base64url).
# This encrypts the stateless OAuth transaction, MCP access/refresh tokens,
# and action tickets. Never commit the real value.
MCP_AUTH_SECRET=

# Recommended in production. Example: https://your-project.vercel.app
# If omitted, request URL origin is used.
PUBLIC_BASE_URL=

# Optional but recommended for a personal deployment: comma/space-separated EVE character IDs allowed to sign in.
# Leave empty to allow any EVE character to authenticate against their own data.
EVE_ALLOWED_CHARACTER_IDS=

# Space-separated ESI scopes enabled on YOUR EVE Developer Application.
# The sample below is read-oriented and can be reduced further.
EVE_ESI_SCOPES="esi-assets.read_assets.v1 esi-location.read_location.v1 esi-location.read_ship_type.v1 esi-location.read_online.v1 esi-skills.read_skills.v1 esi-skills.read_skillqueue.v1 esi-wallet.read_character_wallet.v1 esi-characters.read_loyalty.v1 esi-characters.read_standings.v1 esi-fittings.read_fittings.v1 esi-markets.read_character_orders.v1 esi-clones.read_clones.v1 esi-clones.read_implants.v1"

# Off by default. Set true only after enabling the corresponding ESI write scopes
# in your own EVE Developer Application and reviewing docs/SECURITY.md.
EVE_ENABLE_WRITE_ACTIONS=false

# Optional operational controls.
MAX_ESI_PAGES=50
MCP_REFRESH_TTL_DAYS=7
EVE_USER_AGENT="eve-esi-llm-bridge/0.1.0 (self-hosted)"
